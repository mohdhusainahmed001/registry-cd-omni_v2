{erl_opts, [no_debug_info]}.
{overrides, [{override, [{erl_opts, [no_debug_info]}]}]}.

{deps, [
  {cowboy,   {git, "https://github.com/ninenines/cowboy.git", {tag, "2.12.0"}}},
  {jiffy,    {git, "https://github.com/davisp/jiffy.git",     {tag, "1.1.2"}}},
  {prometheus, {git, "https://github.com/deadtrickster/prometheus.erl.git", {tag, "v4.11.0"}}},
  {recon ,  {git, "https://github.com/ferd/recon.git" ,       {tag,"2.5.6"}}}
]}.

{shell, [
  {vm_args, "config/vm.args"},
    {apps, [cowboy, jiffy, prometheus, registry]}
]}.

{relx,
  [
    {
      release,{registry, "0.0.1"},
      [sasl,cowboy,jiffy, prometheus, recon, registry]
    },
    {vm_args,     "./config/vm.args"},
    {sys_config,  "./config/sys.config"},
    {overlay, [{mkdir, "config"},
               {template, "config/registry.config", "config/registry.config"}]},
    {mode, prod}
  ]
}.
